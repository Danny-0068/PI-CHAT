# -----------------------------------------------------------------------------
# Relay — Environment Configuration Template
# Fictional company: Acme Labs | Demo-safe defaults
# -----------------------------------------------------------------------------

# Application
APP_NAME=Relay
ENV=development
PORT=8000
DEBUG=true

# Security
# In production, must be at least 32 characters long.
SECRET_KEY=demo_dev_secret_key_change_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
POSTGRES_USER=relay_user
POSTGRES_PASSWORD=relay_password
POSTGRES_DB=relay_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://relay_user:relay_password@postgres:5432/relay_db

# Local development override (when running backend outside Docker)
# DATABASE_URL=postgresql+asyncpg://relay_user:relay_password@localhost:5432/relay_db

# Frontend
VITE_API_URL=http://localhost:8000
